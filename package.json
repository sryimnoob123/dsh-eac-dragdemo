{
  "name": "@dsh-community/dsh-drop-to-path-electron",
  "version": "0.0.1",
  "description": "Demo: drag a local file into the DSH web GUI and get its REAL absolute path instantly — via Electron's webUtils.getPathForFile. No disk search, no lag. Only works inside the Electron desktop shell (not a normal browser).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web",
    "ui",
    "drag",
    "drop",
    "path",
    "electron"
  ],
  "license": "MIT"
}